# Editor files
.*.swp

# Claude Code local settings
.claude/*.local.json

# Explicitly exclude META.json!
!/META.json

# Generated make files
meta.mk
control.mk

# Compiler output
*.o
*.so
.deps/

# built targets
# Note: Version-specific files (sql/*--*.sql) are tracked in git and should be
# committed once a version is really released (immutable from then on) --
# except sql/extension_drop--stable.sql, which is just a mechanical copy of
# sql/extension_drop.sql for as long as default_version is the stable
# pseudo-version, so committing it would just duplicate that file.
sql/extension_drop--stable.sql

# Test artifacts
results/
regression.diffs
regression.out

# Generated sql/ directory for test/build
# Created by make test-build. See README.asc for details.
test/build/sql/

# Auto-generated schedule file for test/install
# Created by make when test/install/*.sql files exist.
test/install/schedule

# Misc
tmp/
.DS_Store

# pg_tle generated files
/pg_tle/
